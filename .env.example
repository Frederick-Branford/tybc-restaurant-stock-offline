# ============================================================
# TOM YUM BANG C — Restaurant Stock
# Environment Template
# ============================================================

# Supabase — public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only
# NEVER expose this value to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — optional cloud AI, server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Local AI
# Keep false by default.
# Start-TomYum-Stock-AI.cmd enables Local AI only for the local runtime.
AI_LOCAL_ENABLED=false

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=10m
# Offline Docker server runtime.
# Internal Docker URL; never expose the gateway to the LAN.
TYBC_SUPABASE_URL=
TYBC_SUPABASE_PUBLISHABLE_KEY=
TYBC_OFFLINE_CONTAINER=false
