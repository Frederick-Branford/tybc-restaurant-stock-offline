# TYBC internal gateway — routes the two prefixes supabase-js uses and enforces an
# apikey allowlist. Rendered at container start (only ${UPPER_CASE} env vars are
# substituted). Never published to the host.
# JWT-length keys exceed nginx's default 64-byte map bucket (found in the Phase 2 spike).
map_hash_bucket_size 256;

map $http_apikey $tybc_key_ok {
  default                0;
  "${ANON_KEY}"          1;
  "${SERVICE_ROLE_KEY}"  1;
}

server {
  listen 8000;
  server_name _;
  client_max_body_size 1m;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /healthz { default_type text/plain; return 200 "ok"; }

  location /auth/v1/ {
    if ($tybc_key_ok = 0) { return 401; }
    proxy_read_timeout 15s;
    proxy_pass http://auth:9999/;
  }

  location /rest/v1/ {
    if ($tybc_key_ok = 0) { return 401; }
    proxy_read_timeout 30s;
    proxy_pass http://rest:3000/;
  }

  location / { return 404; }
}
